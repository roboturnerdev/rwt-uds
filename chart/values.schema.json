{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "domain",
    "service",
    "selector",
    "sso",
    "additionalNetworkAllow"
  ],
  "properties": {
    "domain": {
      "type": "object",
      "required": [
        "host",
        "name"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "service": {
      "type": "object",
      "required": [
        "name",
        "port",
        "targetPort"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "targetPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "selector": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "sso": {
      "type": "object",
      "required": [
        "enabled",
        "clientId",
        "groups"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "clientId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^uds-[a-z0-9-]+$"
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/.+"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "groups": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "additionalNetworkAllow": {
      "type": "array"
    }
  }
}